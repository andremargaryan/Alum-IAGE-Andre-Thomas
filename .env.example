# Copier ce fichier en ".env" (même dossier) puis remplir les valeurs.
# Le fichier .env est ignoré par Git : il ne doit JAMAIS être commité.

# Clé de signature des jetons JWT, encodée en Base64 (au moins 32 octets).
# Pour en générer une :
#   PowerShell : [Convert]::ToBase64String((1..48 | ForEach-Object { Get-Random -Maximum 256 }))
#   Linux/Mac  : openssl rand -base64 48
JWT_SECRET=
